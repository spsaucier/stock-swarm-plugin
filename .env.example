# Recommended: Alpha Vantage MCP (official) — https://github.com/alphavantage/alpha_vantage_mcp
# Free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Optional: EODHD REST skill — https://eodhd.com/financial-apis/
EODHD_API_KEY=

# Optional: local read-only Robinhood MCP (portfolio-analyzer only)
# Any broker export works without these — use portfolio-export-analyzer instead.
#ROBINHOOD_USERNAME=
#ROBINHOOD_PASSWORD=
#ROBINHOOD_TOTP_SECRET=
#ROBINHOOD_APPROVAL_TIMEOUT=60
